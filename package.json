{
    "name": "Melvec",
    "version": "0.2.2",
    "description": "Your personal media library management tool.",
    "author": {
        "name": "www.melvec.org",
        "email": "hello@melvec.org",
        "url": "https://www.melvec.org/"
    },
    "main": "src/main/main.js",
    "build": {
        "appId": "org.melvec",
        "productName": "Melvec",
        "asar": true,
        "protocols": {
            "name": "Melvec",
            "schemes": [
                "Melvec"
            ]
        },
        "directories": {
            "output": "dist-mac",
            "buildResources": "build"
        },
        "files": [
            "help.html",
            "help-docs**/*",
            "dist/**/*",
            "src/main/**/*",
            "src/events/**/*",
            "src/services/**/*",
            "src/configs/**/*",
            "src/constants/**/*",
            "resources/locations/cities/geoSpatialReference.json",
            "resources/locations/poi/geoSpatialReference.json",
            "!**/*.test.js",
            "!discard/**/*",
            "!**/*.map",
            "node_modules/**/*",
            "package.json",
            "!node_modules/ffmpeg-static/**",
            "!node_modules/ffprobe-static/**"
        ],
        "extraResources": [
            {
                "from": "bin",
                "to": "bin"
            }
        ],
        "mac": {
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "icon": "build/icon.icns",
            "category": "public.app-category.productivity",
            "darkModeSupport": true,
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist"
        },
        "dmg": {
            "iconSize": 100,
            "contents": [
                {
                    "x": 410,
                    "y": 220,
                    "type": "link",
                    "path": "/Applications"
                },
                {
                    "x": 130,
                    "y": 220,
                    "type": "file"
                }
            ]
        }
    },
    "scripts": {
        "test": "jest",
        "build:preload": "webpack --config ./webpack.preload.config.js",
        "build:renderer": "webpack --config ./webpack.config.js",
        "build": "npm run build:preload && npm run build:renderer",
        "build:preload:prod": "webpack --mode production --config ./webpack.preload.config.js",
        "build:renderer:prod": "webpack --mode production --config ./webpack.config.js",
        "build:prod": "npm run build:preload:prod && npm run build:renderer:prod",
        "start": "electron src/main/main.js --trace-warnings",
        "rebuild": "electron-rebuild -f -w better-sqlite3",
        "build:mac": "npm run build:prod && electron-builder --mac --x64 --arm64 && node notarize.js",
        "icns": "iconutil -c icns melvec.iconset -o build/icon.icns",
        "postinstall": "electron-builder install-app-deps",
        "lint": "npx eslint ."
    },
    "license": "Custom",
    "dependencies": {
        "better-sqlite3": "^12.5.0",
        "directory-tree": "^3.5.2",
        "exifr": "^7.1.3",
        "ffmpeg-static": "^5.3.0",
        "ffprobe-static": "^3.1.0",
        "fs-extra": "^11.2.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/preset-env": "^7.25.2",
        "@babel/preset-react": "^7.24.7",
        "@electron/notarize": "^3.1.1",
        "@electron/rebuild": "^4.0.2",
        "babel-loader": "^9.1.3",
        "css-loader": "^6.2.0",
        "csvtojson": "^2.0.14",
        "electron": "^39.2.7",
        "electron-builder": "^26.8.1",
        "electron-rebuild": "^3.2.9",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "html-webpack-plugin": "^5.6.0",
        "iconutil": "^1.0.2",
        "jest": "^29.7.0",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.7.4",
        "style-loader": "^4.0.0",
        "webpack": "^5.93.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4"
    },
    "jest": {
        "moduleNameMapper": {
            "^__components/(.*)$": "<rootDir>/src/ui/components/$1",
            "^__events/(.*)$": "<rootDir>/src/events/$1",
            "^__contexts/(.*)$": "<rootDir>/src/ui/contexts/$1",
            "^__configs/(.*)$": "<rootDir>/src/configs/$1",
            "^__styles/(.*)$": "<rootDir>/src/ui/styles/$1",
            "^__utils/(.*)$": "<rootDir>/src/ui/utils/$1",
            "^__actions/(.*)$": "<rootDir>/src/ui/actions/$1",
            "^__constants/(.*)$": "<rootDir>/src/constants/$1"
        }
    }
}
